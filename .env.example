# Puerto HTTP
PORT=8787
# Archivo SQLite (en producción, dentro de un volumen persistente)
DATABASE_PATH=data/carga-y-ahorra.db
# Token de acceso. MUY recomendado si la app está expuesta a internet.
APP_TOKEN=
# Horas sin actualización exitosa de una fuente antes de marcar sus promociones como STALE
STALE_AFTER_HOURS=72
# Marca de estación para precios de referencia
FUEL_BRAND_ID=axion
# Jobs programados en el mismo proceso (importación cada 6 h, staleness cada 1 h, precios cada 24 h)
ENABLE_SCHEDULER=true
# Cargar las promociones candidatas de la investigación inicial (sin verificar)
SEED_CANDIDATE_PROMOTIONS=true
# URLs oficiales por fuente (separadas por coma); sobrescriben las del código.
# SOURCE_BBVA_BENEFICIOS_DETAIL_URLS=https://...bases-y-condiciones-axion...
# SOURCE_BRUBANK_HELP_INDEX_URLS=https://help.brubank.com/es/collections/2846519-promociones
# SOURCE_AXION_BENEFICIOS_INDEX_URLS=https://www.axionenergy.com/beneficios-y-promociones/
