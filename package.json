{
  "name": "carga-y-ahorra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "npm run data -- --offline && vite",
    "build": "vite build",
    "start": "NODE_EXTRA_CA_CERTS=certs/digicert-global-g2-tls-rsa-sha256-2020-ca1.pem NODE_USE_ENV_PROXY=1 NODE_ENV=production NODE_OPTIONS=\"--disable-warning=ExperimentalWarning --disable-warning=UNDICI-EHPA\" tsx src/server/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "import": "NODE_EXTRA_CA_CERTS=certs/digicert-global-g2-tls-rsa-sha256-2020-ca1.pem NODE_USE_ENV_PROXY=1 NODE_OPTIONS=\"--disable-warning=ExperimentalWarning --disable-warning=UNDICI-EHPA\" tsx src/server/cli.ts import",
    "jobs": "NODE_EXTRA_CA_CERTS=certs/digicert-global-g2-tls-rsa-sha256-2020-ca1.pem NODE_USE_ENV_PROXY=1 NODE_OPTIONS=\"--disable-warning=ExperimentalWarning --disable-warning=UNDICI-EHPA\" tsx src/server/cli.ts jobs",
    "seed": "NODE_EXTRA_CA_CERTS=certs/digicert-global-g2-tls-rsa-sha256-2020-ca1.pem NODE_USE_ENV_PROXY=1 NODE_OPTIONS=\"--disable-warning=ExperimentalWarning --disable-warning=UNDICI-EHPA\" tsx src/server/cli.ts seed",
    "axion": "NODE_EXTRA_CA_CERTS=certs/digicert-global-g2-tls-rsa-sha256-2020-ca1.pem NODE_USE_ENV_PROXY=1 NODE_OPTIONS=\"--disable-warning=ExperimentalWarning --disable-warning=UNDICI-EHPA\" tsx src/server/cli.ts axion",
    "data": "NODE_EXTRA_CA_CERTS=certs/digicert-global-g2-tls-rsa-sha256-2020-ca1.pem NODE_USE_ENV_PROXY=1 NODE_OPTIONS=\"--disable-warning=ExperimentalWarning --disable-warning=UNDICI-EHPA\" tsx src/server/export-static.ts",
    "dev:server": "NODE_EXTRA_CA_CERTS=certs/digicert-global-g2-tls-rsa-sha256-2020-ca1.pem NODE_USE_ENV_PROXY=1 NODE_OPTIONS=\"--disable-warning=ExperimentalWarning --disable-warning=UNDICI-EHPA\" tsx watch src/server/main.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
